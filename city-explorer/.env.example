# App environment. EXPO_PUBLIC_* values are bundled into the app binary, so
# only ever put publishable keys here. Server-side keys live in scripts/.env.

# Local: run `npx supabase status` for the URL and publishable/anon key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON=<anon or publishable key>

# Mapbox public token (pk.*), from https://account.mapbox.com
EXPO_PUBLIC_MAPBOX_TOKEN=pk.<...>

# The Mapbox secret download token (sk.* with DOWNLOADS:READ) is NOT set here.
# Put it in ~/.gradle/gradle.properties as MAPBOX_DOWNLOADS_TOKEN=sk.... and in
# ~/.netrc as `machine api.mapbox.com login mapbox password sk....` (chmod 600).

# Google sign-in (optional). iOS OAuth client from Google Cloud Console; the
# same client must be added to Supabase Auth > Providers > Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
