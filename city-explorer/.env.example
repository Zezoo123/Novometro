# App environment. EXPO_PUBLIC_* values are bundled into the app binary, so
# only ever put publishable keys here. Server-side keys live in scripts/.env.

# Local: run `npx supabase status` for the URL and publishable/anon key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON=<anon or publishable key>

# Mapbox public token (pk.*), from https://account.mapbox.com
EXPO_PUBLIC_MAPBOX_TOKEN=pk.<...>

# Mapbox secret download token (sk.* with DOWNLOADS:READ). Used only at native
# build time by the @rnmapbox/maps config plugin; never bundled.
MAPBOX_DOWNLOADS_TOKEN=sk.<...>
