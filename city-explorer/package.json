{
  "name": "city-explorer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "import:tfl": "node --env-file=scripts/.env --import=tsx scripts/import_tfl.ts",
    "import:tfl:bus": "node --env-file=scripts/.env --import=tsx scripts/import_tfl_bus.ts",
    "db:push:hosted": "node --env-file=scripts/.env --import=tsx scripts/apply_hosted_migrations.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@rnmapbox/maps": "^10.1.41",
    "@supabase/supabase-js": "^2.56.1",
    "@tanstack/react-query": "^5.85.5",
    "expo": "~53.0.22",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "expo-router": "~5.1.11",
    "@react-native-async-storage/async-storage": "2.1.2",
    "react-native-view-shot": "4.0.3",
    "expo-sharing": "~13.1.5",
    "expo-notifications": "~0.31.5",
    "expo-apple-authentication": "~7.2.4",
    "expo-auth-session": "~6.2.1",
    "expo-crypto": "~14.1.5",
    "expo-web-browser": "~14.2.0",
    "expo-image-picker": "~16.1.4",
    "expo-image-manipulator": "~13.1.7",
    "expo-file-system": "~18.1.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.3.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3"
  },
  "private": true
}
